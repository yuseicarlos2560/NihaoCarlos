[
  {"start": 0.0, "text": "大家好我是小李"},
  {"start": 1.0, "text": "2023年西雅图发生了一次2.3级的地震"},
  {"start": 4.0, "text": "震源不来自地壳深处"},
  {"start": 6.0, "text": "而是Taylor Swift演唱会上"},
  {"start": 8.0, "text": "蹦跶的7.2万名狂热观众"},
  {"start": 10.0, "text": "她一轮演唱会狂揽20多亿美元票房"},
  {"start": 13.0, "text": "比很多国家一整年的GDP都要高"},
  {"start": 16.0, "text": "不光是她"},
  {"start": 16.0, "text": "碧昂斯去年在瑞典开演唱会"},
  {"start": 18.0, "text": "直接拉高了瑞典当月0.2%的通胀"},
  {"start": 22.0, "text": "中国这边同样疯狂"},
  {"start": 23.0, "text": "周杰伦在海口开演唱会"},
  {"start": 25.0, "text": "短短4天就从歌迷口袋里"},
  {"start": 27.0, "text": "撬动了10个亿的旅游收入"},
  {"start": 29.0, "text": "演唱会的魅力就是如此之大"},
  {"start": 31.0, "text": "甚至在逃犯"},
  {"start": 32.0, "text": "在听张学友的演唱会和自由之间"},
  {"start": 34.0, "text": "都坚定地选择了前者"},
  {"start": 36.0, "text": "而就在顶流们数钱到手抽筋的同时"},
  {"start": 39.0, "text": "更多的是算不明白账的人"},
  {"start": 42.0, "text": "水果姐想复刻Taylor的盛况"},
  {"start": 44.0, "text": "结果票只卖出不到一半"},
  {"start": 46.0, "text": "连华语顶流蔡依林"},
  {"start": 47.0, "text": "在台北大巨蛋砸了两个亿做舞台"},
  {"start": 48.0, "text": "三场演完下来都倒亏了七千万"},
  {"start": 51.0, "text": "一半是印钞机"},
  {"start": 52.0, "text": "一半是碎钞机"},
  {"start": 53.0, "text": "演唱会到底是一门什么样的生意"},
  {"start": 56.0, "text": "今天呢"},
  {"start": 57.0, "text": "小李就顺着一张门票"},
  {"start": 58.0, "text": "带你把这条产业链从头拆到尾"},
  {"start": 61.0, "text": "看看谁在赚钱"},
  {"start": 62.0, "text": "谁在亏钱"},
  {"start": 63.0, "text": "抢票到手酸的我们"},
  {"start": 65.0, "text": "在一场场盛宴中又扮演了什么角色"},
  {"start": 71.0, "text": "最早的演唱会门票卖多少呢"},
  {"start": 73.0, "text": "让我们把时间拨回1672年"},
  {"start": 75.0, "text": "一个叫约翰·班尼斯特的小提琴手"},
  {"start": 77.0, "text": "在自家楼上搞了一场公开表演"},
  {"start": 80.0, "text": "进门收1先令"},
  {"start": 81.0, "text": "这是人类历史上有记载的"},
  {"start": 83.0, "text": "第一场收费公开演出"},
  {"start": 85.0, "text": "到了1840年代工业革命催生了铁路"},
  {"start": 88.0, "text": "李斯特坐着火车跑遍欧洲"},
  {"start": 90.0, "text": "场场爆满"},
  {"start": 91.0, "text": "再往后一百多年"},
  {"start": 92.0, "text": "二战结束了"},
  {"start": 93.0, "text": "美国经济大爆发"},
  {"start": 94.0, "text": "婴儿潮一代长大之后"},
  {"start": 96.0, "text": "变成了人类历史上"},
  {"start": 97.0, "text": "第一批手里攥着自己零花钱的"},
  {"start": 99.0, "text": "青少年消费群体"},
  {"start": 100.0, "text": "他们不爱听古典乐"},
  {"start": 102.0, "text": "要听摇滚"},
  {"start": 103.0, "text": "1956年"},
  {"start": 104.0, "text": "猫王开启了万人演唱会"},
  {"start": 106.0, "text": "全场都疯了"},
  {"start": 107.0, "text": "再到九年后的披头士"},
  {"start": 108.0, "text": "一场下来狂揽30多万美元"},
  {"start": 110.0, "text": "观众的尖叫声"},
  {"start": 112.0, "text": "大到乐队自己都听不见在弹什么"},
  {"start": 114.0, "text": "当时大家都觉得"},
  {"start": 115.0, "text": "这就是极限了"},
  {"start": 116.0, "text": "然而"},
  {"start": 117.0, "text": "1996年"},
  {"start": 117.0, "text": "迈克尔·杰克逊靠82场演出"},
  {"start": 120.0, "text": "拿下了1.65亿美元的票房"},
  {"start": 122.0, "text": "再往后"},
  {"start": 123.0, "text": "U2把总票房推到了7.36亿"},
  {"start": 126.0, "text": "Coldplay历时数年突破了10亿美元的大关"},
  {"start": 129.0, "text": "而现如今的票房天花板"},
  {"start": 131.0, "text": "就是开头我们说到的"},
  {"start": 132.0, "text": "Taylor Swift的时代巡演"},
  {"start": 134.0, "text": "横跨五大洲149场"},
  {"start": 136.0, "text": "官方报告的总票房高达20.77亿美元"},
  {"start": 140.0, "text": "从小阁楼里的1先令门票"},
  {"start": 142.0, "text": "再到今天"},
  {"start": 143.0, "text": "一轮巡演的经济影响力超过一个国家"},
  {"start": 145.0, "text": "300多年"},
  {"start": 146.0, "text": "演唱会从一门小生意"},
  {"start": 148.0, "text": "长成了一条吞吐百亿资金的庞大产业链"},
  {"start": 150.0, "text": "票价也动辄几百上千"},
  {"start": 153.0, "text": "这里我们做一个小测试"},
  {"start": 157.0, "text": "觉得是需求变多的请打1"},
  {"start": 159.0, "text": "觉得是黄牛太多的请打2"},
  {"start": 161.0, "text": "觉得是通货膨胀的请打3"},
  {"start": 163.0, "text": "其实都只是对了一部分"},
  {"start": 165.0, "text": "小李找了一大堆研究演唱会经济的论文"},
  {"start": 168.0, "text": "在里面总结出了两个原因"},
  {"start": 170.0, "text": "第一个就藏在你每天听歌的习惯里"},
  {"start": 172.0, "text": "没错就是流媒体的出现"},
  {"start": 174.0, "text": "我们拿大家都熟悉的周董算笔账"},
  {"start": 176.0, "text": "当年他开无与伦比演唱会的时候"},
  {"start": 179.0, "text": "最便宜的门票是180块"},
  {"start": 181.0, "text": "同一时期买一张正版的七里香CD"},
  {"start": 183.0, "text": "大概需要30块"},
  {"start": 184.0, "text": "这就意味着小小李只要忍住少买6张CD"},
  {"start": 188.0, "text": "就能去现场看一眼活的周杰伦"},
  {"start": 190.0, "text": "在那个唱片黄金年代呢"},
  {"start": 192.0, "text": "无论是欧美的摇滚巨星"},
  {"start": 193.0, "text": "还是华语天王"},
  {"start": 194.0, "text": "赚钱的主力都还是卖实体专辑"},
  {"start": 197.0, "text": "演唱会更像是一个超大型的配套宣传活动"},
  {"start": 200.0, "text": "票价定得不高"},
  {"start": 201.0, "text": "甚至故意很便宜"},
  {"start": 202.0, "text": "相当于歌手在花钱请你来现场"},
  {"start": 205.0, "text": "给你做广告"},
  {"start": 206.0, "text": "用震撼的体验把你勾引回去买CD"},
  {"start": 209.0, "text": "但是呢流媒体把这个盘子给掀了"},
  {"start": 211.0, "text": "现在呢你在APP上花15块钱开个月卡"},
  {"start": 214.0, "text": "几千万首歌随便你听"},
  {"start": 215.0, "text": "连演唱会的Live版本都有"},
  {"start": 217.0, "text": "音质甚至比现场还要好"},
  {"start": 219.0, "text": "我们听歌听爽了"},
  {"start": 221.0, "text": "但对于歌手来说是天塌了"},
  {"start": 222.0, "text": "经济学上这叫"},
  {"start": 225.0, "text": "啥意思呢"},
  {"start": 225.0, "text": "就是唱片和演唱会本来是打配合的"},
  {"start": 228.0, "text": "过去是唱片赚一份"},
  {"start": 230.0, "text": "现场赚一份"},
  {"start": 231.0, "text": "现在你一个月花十几块钱"},
  {"start": 233.0, "text": "就把听歌这事打发了"},
  {"start": 235.0, "text": "唱片几乎不赚钱了"},
  {"start": 236.0, "text": "那演唱会就必须把这两份钱一起赚回来"},
  {"start": 240.0, "text": "第二个原因呢"},
  {"start": 241.0, "text": "藏在我们刚才提到的"},
  {"start": 242.0, "text": "300年的演唱会历史里"},
  {"start": 243.0, "text": "经济学家又起了个名词叫"},
  {"start": 247.0, "text": "你看经济学家这小词一个个的"},
  {"start": 249.0, "text": "什么意思呢"},
  {"start": 250.0, "text": "工业革命以来"},
  {"start": 251.0, "text": "工厂流水线一天能造几百台手机"},
  {"start": 253.0, "text": "你看效率提高了"},
  {"start": 254.0, "text": "工人的工资能跟着涨"},
  {"start": 256.0, "text": "但是你看舞台上的表演者呢"},
  {"start": 258.0, "text": "从17世纪那个"},
  {"start": 259.0, "text": "在阁楼拉小提琴的班尼斯特"},
  {"start": 261.0, "text": "到今天的Taylor Swift"},
  {"start": 262.0, "text": "艺术家的表演效率"},
  {"start": 264.0, "text": "300多年来几乎没有变过"},
  {"start": 266.0, "text": "周杰伦不可能用两倍速把晴天唱完"},
  {"start": 268.0, "text": "他一次也只能在一个城市"},
  {"start": 270.0, "text": "唱给一个场馆里的这些人听"},
  {"start": 272.0, "text": "但同时呢"},
  {"start": 273.0, "text": "制作成本却在飙升"},
  {"start": 275.0, "text": "过去几个乐手几把吉他"},
  {"start": 276.0, "text": "一块简单的布景板就能唱一晚上"},
  {"start": 279.0, "text": "现在呢"},
  {"start": 279.0, "text": "我们的胃口是越来越刁钻了"},
  {"start": 281.0, "text": "你看前一阵侃爷"},
  {"start": 282.0, "text": "直接做了个超大地球"},
  {"start": 284.0, "text": "cosplay微信"},
  {"start": 285.0, "text": "所有人都在卷舞美"},
  {"start": 286.0, "text": "卷视觉"},
  {"start": 288.0, "text": "就像我们开头提到的"},
  {"start": 289.0, "text": "蔡依林砸了整整两个亿去做舞台"},
  {"start": 291.0, "text": "观众们大饱眼福"},
  {"start": 293.0, "text": "Taylor Swift的时代巡演呢"},
  {"start": 294.0, "text": "光运舞台设备就要足足90多辆重型卡车"},
  {"start": 297.0, "text": "整个舞台全是液压升降机和巨型LED地板"},
  {"start": 301.0, "text": "你看"},
  {"start": 302.0, "text": "场租在涨"},
  {"start": 302.0, "text": "卡车物流在涨"},
  {"start": 304.0, "text": "上百个安保舞者顶级灯光师的工资都在涨"},
  {"start": 307.0, "text": "而这笔巨额账单"},
  {"start": 308.0, "text": "最终全摊进了我们的票价里"},
  {"start": 310.0, "text": "总结一下就是"},
  {"start": 311.0, "text": "一方面你不再为录音付费了"},
  {"start": 313.0, "text": "所以现场门票必须变贵"},
  {"start": 315.0, "text": "另一方面"},
  {"start": 315.0, "text": "演出的内卷成本降不下来"},
  {"start": 317.0, "text": "因为没人能同时分身开两场演唱会"},
  {"start": 320.0, "text": "这两股力量同时发力"},
  {"start": 321.0, "text": "就从我们的钱包里丝滑地把钱给夹走了"},
  {"start": 324.0, "text": "而夹走之后呢"},
  {"start": 326.0, "text": "这笔钱就开始分叉"},
  {"start": 327.0, "text": "流向了背后的各个环节"},
  {"start": 332.0, "text": "2024年"},
  {"start": 333.0, "text": "美国司法部和40多个州"},
  {"start": 334.0, "text": "一起把全球最大的演出公司"},
  {"start": 336.0, "text": "Live Nation告上了法庭"},
  {"start": 338.0, "text": "指控它垄断了整个现场演出行业"},
  {"start": 340.0, "text": "就在上个月"},
  {"start": 341.0, "text": "这条指控最终以罚款2.8亿美元"},
  {"start": 343.0, "text": "剥离13座场馆"},
  {"start": 345.0, "text": "服务费封顶15%的代价达成了和解"},
  {"start": 347.0, "text": "但其中36个州仍然觉得这个和解太轻了"},
  {"start": 350.0, "text": "拒绝接受"},
  {"start": 351.0, "text": "所以官司现在还没打完"},
  {"start": 353.0, "text": "为什么一家卖票的公司"},
  {"start": 354.0, "text": "能惹来这么大的官司"},
  {"start": 356.0, "text": "因为Live Nation不只是卖票"},
  {"start": 358.0, "text": "它同时拥有票务平台"},
  {"start": 359.0, "text": "控制着几百座场馆"},
  {"start": 361.0, "text": "还同时做演出推广和艺人经纪"},
  {"start": 363.0, "text": "从你打开APP买票的那一秒"},
  {"start": 365.0, "text": "到你走进场馆喝的那杯啤酒"},
  {"start": 367.0, "text": "整个链它全包了"},
  {"start": 368.0, "text": "而这恰恰就是藏在一张门票背后的"},
  {"start": 371.0, "text": "一台分润机器的缩影"},
  {"start": 372.0, "text": "我们就拿一张780块的票来拆拆看"},
  {"start": 375.0, "text": "这笔钱到底是怎么被一层层切走的"},
  {"start": 377.0, "text": "来 第一层是票务平台"},
  {"start": 379.0, "text": "大麦猫眼或者海外的Ticketmaster"},
  {"start": 382.0, "text": "基础抽成是5%到10%"},
  {"start": 384.0, "text": "但一旦加上设施费"},
  {"start": 386.0, "text": "订单处理费这些所谓的便利费的名目"},
  {"start": 389.0, "text": "你实际多掏的可能是20%甚至30%"},
  {"start": 392.0, "text": "Live Nation被告的核心原因之一"},
  {"start": 394.0, "text": "就是Ticketmaster的各种附加费"},
  {"start": 396.0, "text": "平均占到票面价格的27%"},
  {"start": 398.0, "text": "而且还藏到结账的最后一步才显示"},
  {"start": 401.0, "text": "你还没反应过来比价就已经付款了"},
  {"start": 404.0, "text": "第二层是场馆和制作"},
  {"start": 405.0, "text": "大型体育场单场租金是百万起步"},
  {"start": 408.0, "text": "不管来三万人还是五万人"},
  {"start": 410.0, "text": "一分不少"},
  {"start": 410.0, "text": "再加上我们刚说的那些大型舞美机械设备"},
  {"start": 413.0, "text": "这些巨额的固定成本"},
  {"start": 415.0, "text": "摊到每张票上又切走了一大块"},
  {"start": 417.0, "text": "第三层是主办方"},
  {"start": 418.0, "text": "租场地报审批买保险请保安"},
  {"start": 421.0, "text": "全得先垫钱"},
  {"start": 422.0, "text": "听起来像幕后大老板吗"},
  {"start": 424.0, "text": "其实他们的毛利率通常只有10%到20%"},
  {"start": 427.0, "text": "前提还得是票卖光了"},
  {"start": 429.0, "text": "一旦预售数据不好看"},
  {"start": 430.0, "text": "就会及时止损宣布取消"},
  {"start": 432.0, "text": "这也是这两年我们看到大量的演唱会"},
  {"start": 434.0, "text": "突然消失的真正原因"},
  {"start": 436.0, "text": "第四层就是版权费"},
  {"start": 437.0, "text": "最近李荣浩和单依纯因为版权就闹得不可开交"},
  {"start": 440.0, "text": "其实不只是翻唱"},
  {"start": 441.0, "text": "哪怕歌手唱的是自己的歌"},
  {"start": 443.0, "text": "只要词曲涉及共同创作者"},
  {"start": 445.0, "text": "也要付版权分成"},
  {"start": 447.0, "text": "一场5万人的演唱会呢均价是800块"},
  {"start": 450.0, "text": "光4%的词曲版权费就是160万"},
  {"start": 452.0, "text": "四层切完你那780块可能只剩两三百"},
  {"start": 455.0, "text": "这下终于轮到歌手团队了"},
  {"start": 457.0, "text": "但这两三百还要再分给"},
  {"start": 459.0, "text": "经纪公司乐队舞者"},
  {"start": 461.0, "text": "最后还要扣税"},
  {"start": 462.0, "text": "所以绝大部分中腰部歌手开演唱会"},
  {"start": 464.0, "text": "利润是薄得跟纸一样"},
  {"start": 466.0, "text": "那周杰伦和Taylor Swift怎么还能赚几个亿呢"},
  {"start": 469.0, "text": "因为到了超级顶流的级别规则就变了"},
  {"start": 472.0, "text": "就有人透露过"},
  {"start": 473.0, "text": "周杰伦演唱会的票房"},
  {"start": 474.0, "text": "分成通常按70%计算"},
  {"start": 476.0, "text": "2024年嘉年华巡回42场"},
  {"start": 478.0, "text": "总票房23.6亿"},
  {"start": 480.0, "text": "如果这个比例是真的"},
  {"start": 481.0, "text": "周杰伦团队的净收益"},
  {"start": 482.0, "text": "就能超过16亿"},
  {"start": 484.0, "text": "Taylor Swift更极端"},
  {"start": 485.0, "text": "据报道"},
  {"start": 486.0, "text": "她可以拿走总票房的85%以上"},
  {"start": 489.0, "text": "所以说怪不得能给工作人员"},
  {"start": 490.0, "text": "发那么大的红包"},
  {"start": 491.0, "text": "好想去给她伴舞"},
  {"start": 493.0, "text": "你看顶流吃肉"},
  {"start": 494.0, "text": "风险可以甩给垫资的主办方"},
  {"start": 496.0, "text": "和很多行业一样"},
  {"start": 497.0, "text": "而且更极端"},
  {"start": 498.0, "text": "演唱会利润分配"},
  {"start": 499.0, "text": "是一个极度折叠的金字塔"},
  {"start": 501.0, "text": "最顶上那1%的艺人"},
  {"start": 503.0, "text": "拿走了行业60%的收入"},
  {"start": 505.0, "text": "当然你可能会想"},
  {"start": 506.0, "text": "Live Nation是不是美国的特殊情况"},
  {"start": 508.0, "text": "还真不是"},
  {"start": 509.0, "text": "2025年"},
  {"start": 510.0, "text": "英国所有在售的体育场体育馆"},
  {"start": 512.0, "text": "和户外演唱会门票里"},
  {"start": 513.0, "text": "Live Nation和它关联公司"},
  {"start": 515.0, "text": "控制了58%"},
  {"start": 517.0, "text": "而英国法定的垄断门槛是25%"},
  {"start": 520.0, "text": "它们已经超了一倍还多"},
  {"start": 521.0, "text": "所以英国在2025年底宣布立法"},
  {"start": 523.0, "text": "禁止以高于面值的价格"},
  {"start": 525.0, "text": "转售演出门票"},
  {"start": 526.0, "text": "这也是目前全球最严厉的反黄牛法之一"},
  {"start": 529.0, "text": "中国的情况呢"},
  {"start": 530.0, "text": "票务市场是大麦领头"},
  {"start": 532.0, "text": "猫眼和票星球跟进的一超两强的格局"},
  {"start": 535.0, "text": "中国的政策规定呢"},
  {"start": 536.0, "text": "公开售票比例不低于85%"},
  {"start": 538.0, "text": "但主办方把票分给多个平台和渠道"},
  {"start": 541.0, "text": "其实很难监督实际有多少票进了公开的池子"},
  {"start": 544.0, "text": "强实名制推行之后"},
  {"start": 546.0, "text": "传统黄牛确实被压缩了空间"},
  {"start": 548.0, "text": "但代拍模式又冒出来了"},
  {"start": 550.0, "text": "你付几千块钱服务费"},
  {"start": 551.0, "text": "黄牛用你的身份信息帮你抢票"},
  {"start": 553.0, "text": "本质上中间环节的利润并没有消失"},
  {"start": 556.0, "text": "韩国则是另一种玩法"},
  {"start": 558.0, "text": "SM YG HYBE这些经纪巨头"},
  {"start": 560.0, "text": "从练习生培训到演唱会推广"},
  {"start": 562.0, "text": "全链通吃"},
  {"start": 563.0, "text": "粉丝想买票还得先花钱加入官方会员"},
  {"start": 567.0, "text": "买门票的资格本身都能卖钱"},
  {"start": 569.0, "text": "所以你看"},
  {"start": 570.0, "text": "各个国家的玩法不同"},
  {"start": 571.0, "text": "但相同点在于"},
  {"start": 572.0, "text": "你多掏的那笔钱"},
  {"start": 574.0, "text": "有相当一部分是为中间环节付的"},
  {"start": 576.0, "text": "查资料的时候"},
  {"start": 577.0, "text": "小李还发现一个很反直觉的事情"},
  {"start": 579.0, "text": "有关于大家深恶痛绝的黄牛"},
  {"start": 581.0, "text": "普林斯顿大学有一个教授做了一个研究"},
  {"start": 584.0, "text": "他说歌手明明知道票供不应求"},
  {"start": 586.0, "text": "为什么不直接涨价"},
  {"start": 588.0, "text": "把票定到市场真实愿意出的价格"},
  {"start": 590.0, "text": "那不就没黄牛了吗"},
  {"start": 591.0, "text": "然后这个教授的结论是"},
  {"start": 593.0, "text": "歌手其实知道票可以卖更贵"},
  {"start": 595.0, "text": "但故意定低价"},
  {"start": 596.0, "text": "为什么"},
  {"start": 597.0, "text": "因为低价是一种公关策略"},
  {"start": 599.0, "text": "制造一种善意"},
  {"start": 654, "text": "现在AI已经能写歌了"},
  {"start": 656, "text": "可以模仿任何人的声线"},
  {"start": 657, "text": "甚至能生成一场虚拟的演唱会"},
  {"start": 659, "text": "你要听一首“AI周杰伦”唱的新歌"},
  {"start": 701, "text": "技术上早已不是问题了"},
  {"start": 703, "text": "但几万人一起喊出同一句歌词"},
  {"start": 705, "text": "旁边陌生人跟你一起哭的那种共振"},
  {"start": 708, "text": "这个AI可做不到"},
  {"start": 710, "text": "伍佰的演唱会为什么会变成全场KTV"},
  {"start": 713, "text": "因为几万个素不相识的人"},
  {"start": 714, "text": "一起扯着嗓子唱同一首歌的感觉"},
  {"start": 717, "text": "平时的生活里没有任何地方能复制"},
  {"start": 720, "text": "伍佰的郑州站演唱会结束后"},
  {"start": 721, "text": "伍佰本人和乐队都退场了"},
  {"start": 724, "text": "几万观众在没有伴奏的情况下"},
  {"start": 726, "text": "自发唱完了一整首《挪威的森林》"},
  {"start": 733, "text": "我想这种经历哪怕过个半年一年的"},
  {"start": 735, "text": "想起来你也会嘴角上扬"},
  {"start": 737, "text": "你看 流媒体上几乎所有歌都能免费听"},
  {"start": 740, "text": "音质可能还比现场好"},
  {"start": 742, "text": "AI能模仿任何人的声音"},
  {"start": 744, "text": "甚至能“复活”已经离开的歌手"},
  {"start": 746, "text": "但几万人同时屏住呼吸"},
  {"start": 748, "text": "等前奏响起的那几秒副歌时"},
  {"start": 751, "text": "全场手机灯光亮成一片星海的那个瞬间"},
  {"start": 753, "text": "没法录屏回放"},
  {"start": 755, "text": "过了就是过了"},
  {"start": 756, "text": "演唱会从头到尾只卖一样东西"},
  {"start": 759, "text": "此时此刻"},
  {"start": 800, "text": "你在这里"},
  {"start": 801, "text": "所有商业逻辑都能解释它的价格"},
  {"start": 803, "text": "但没有一条能解释它为什么值得"},
  {"start": 806, "text": "这个问题只有坐在观众席上的你可以回答"},
  {"start": 810, "text": "所以回到开头那个问题"},
  {"start": 812, "text": "演唱会到底是一门什么生意"},
  {"start": 814, "text": "顺着一张票看下来"},
  {"start": 815, "text": "你的钱先被流媒体时代的结构性成本推高了"},
  {"start": 818, "text": "再被平台 场馆 主办方"},
  {"start": 820, "text": "歌手和黄牛一层层切走"},
  {"start": 823, "text": "接着被城市拿去算了一笔"},
  {"start": 825, "text": "未必完全站得住脚的GDP账"},
  {"start": 827, "text": "最后你还免费替这套系统做了一轮传播"},
  {"start": 830, "text": "但小李还有屏幕前的你我"},
  {"start": 832, "text": "下次一定还是会继续同样的事情"},
  {"start": 834, "text": "因为那种和几万人一起喊到失声"},
  {"start": 837, "text": "旁边陌生人跟你一起哭的感觉"},
  {"start": 839, "text": "是不需要任何经济学的框架去解构的"},
  {"start": 842, "text": "也许这就是演唱会最厉害的地方"},
  {"start": 844, "text": "你把它拆得再透"},
  {"start": 845, "text": "到了现场"},
  {"start": 846, "text": "灯一暗前奏一起"},
  {"start": 847, "text": "我一句“听见你说”"},
  {"start": 850, "text": "诶 接上了吗"},
  {"start": 851, "text": "最后想问大家"},
  {"start": 852, "text": "你去过的哪场演唱会"},
  {"start": 854, "text": "让你觉得很值"},
  {"start": 855, "text": "让你回味最久"},
  {"start": 856, "text": "欢迎在评论区打出你pick的名字"},
  {"start": 858, "text": "大家好 我是小李"},
  {"start": 859, "text": "如果今天视频让你觉得有所收获的话"},
  {"start": 900, "text": "记得点赞 评论 收藏"},
  {"start": 901, "text": "我们下期再见"},
  {"start": 902, "text": "拜拜"}
]