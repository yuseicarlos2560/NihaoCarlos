[
  {"start": 0.0, "text": "今年6月"},
  {"start": 1.0, "text": "在木星和金星交汇的那几天"},
  {"start": 7.0, "text": "它预计估值1.5万亿美元"},
  {"start": 9.0, "text": "预计募资500亿美元"},
  {"start": 12.0, "text": "它开口就要吞掉去年整个美股IPO的钱"},
  {"start": 15.0, "text": "还没敲钟"},
  {"start": 16.0, "text": "市值就已经碾压全球99.99%的企业"},
  {"start": 20.0, "text": "这个连上市都得看星象的公司"},
  {"start": 22.0, "text": "就是"},
  {"start": 24.0, "text": "大家好 我是小李"},
  {"start": 25.0, "text": "今天我想带你一起看看"},
  {"start": 27.0, "text": "它这个1.5万亿到底是怎么算出来的"},
  {"start": 29.0, "text": "面对狮子大开口"},
  {"start": 31.0, "text": "怎么大家还在排队送钱"},
  {"start": 32.0, "text": "为什么首富好像也很缺钱"},
  {"start": 34.0, "text": "以及它的上市"},
  {"start": 36.0, "text": "跟我们普通人到底有什么关系"},
  {"start": 41.0, "text": "如果我们以业务方向来看"},
  {"start": 42.0, "text": "马斯克手底下的公司"},
  {"start": 44.0, "text": "可以说他养了7个孩子"},
  {"start": 45.0, "text": "从造铁壳子的"},
  {"start": 47.0, "text": "到拉网线的"},
  {"start": 47.0, "text": "做AI的"},
  {"start": 48.0, "text": "干啥的都有"},
  {"start": 49.0, "text": "那这次IPO呢"},
  {"start": 50.0, "text": "就是他7个孩子里"},
  {"start": 51.0, "text": "两个赚钱的顶梁柱"},
  {"start": 53.0, "text": "SpaceX和星链"},
  {"start": 54.0, "text": "拉着两个亏钱的AI吞金兽"},
  {"start": 56.0, "text": "X和xAI"},
  {"start": 57.0, "text": "一起冲向资本市场"},
  {"start": 59.0, "text": "但是"},
  {"start": 59.0, "text": "凭啥这个组合"},
  {"start": 60.0, "text": "这4个孩子"},
  {"start": 61.0, "text": "加起来能到1.5万亿呢"},
  {"start": 63.0, "text": "甚至马斯克暗示"},
  {"start": 65.0, "text": "应该是到1.75万亿"},
  {"start": 66.0, "text": "我带大家用两个乘法和一个加法"},
  {"start": 68.0, "text": "来快速算一下"},

  {"start": 72.0, "text": "我们先把时间拨回2008年"},
  {"start": 74.0, "text": "SpaceX成立的第6年"},
  {"start": 75.0, "text": "三次发射已经全部失败"},
  {"start": 77.0, "text": "距离破产只有3天"},
  {"start": 79.0, "text": "直到那年9月"},
  {"start": 80.0, "text": "猎鹰一号第4次点火"},
  {"start": 82.0, "text": "终于入轨了"},
  {"start": 83.0, "text": "NASA这才送来了16亿美元的订单"},
  {"start": 85.0, "text": "此时SpaceX的估值是"},

  {"start": 89.0, "text": "我们再拨到2015年1月"},
  {"start": 91.0, "text": "SpaceX拿到了谷歌和富达联合注资的10亿美元"},
  {"start": 95.0, "text": "他宣布要发射数千颗卫星"},
  {"start": 97.0, "text": "给全球拉网线"},
  {"start": 98.0, "text": "这就是现在大名鼎鼎的"},
  {"start": 101.0, "text": "而SpaceX在资本市场的身份"},
  {"start": 103.0, "text": "也从火箭公司"},
  {"start": 105.0, "text": "变成了互联网基础设施公司"},
  {"start": 107.0, "text": "它的估值也直接乘以30"},
  {"start": 109.0, "text": "涨到了"},

  {"start": 112.0, "text": "我们再拨到2024年"},
  {"start": 114.0, "text": "星链的商业模式"},
  {"start": 115.0, "text": "花了快10年终于跑通了"},
  {"start": 117.0, "text": "其实模式本身很简单"},
  {"start": 118.0, "text": "就是先花599美元买一口锅"},
  {"start": 121.0, "text": "每个月再交120美元"},
  {"start": 122.0, "text": "就能连上高速网了"},
  {"start": 124.0, "text": "如果你第一次听到120美元这个价格"},
  {"start": 126.0, "text": "可能觉得很贵"},
  {"start": 127.0, "text": "这里就要插一个很多人不知道的知识点"},
  {"start": 129.0, "text": "在中国"},
  {"start": 130.0, "text": "各种基站、手机信号覆盖到县城"},
  {"start": 132.0, "text": "大家会觉得是理所当然的事"},
  {"start": 134.0, "text": "但全球的地球表面呢"},
  {"start": 136.0, "text": "被地面基站覆盖的区域"},
  {"start": 137.0, "text": "其实只有10%到15%"},
  {"start": 139.0, "text": "剩下90%是完完全全的信号盲区"},

  {"start": 142.0, "text": "美国农村在星链出来之前呢"},
  {"start": 144.0, "text": "能用的卫星宽带"},
  {"start": 145.0, "text": "主要是两个老牌GEO卫星运营商"},
  {"start": 147.0, "text": "月租四五十到一百多美元"},
  {"start": 149.0, "text": "还非常卡"},
  {"start": 150.0, "text": "基本打不了任何需要网速的游戏"},
  {"start": 152.0, "text": "所以对于这部分用户来说"},
  {"start": 154.0, "text": "星链的性价比其实是很高的"},

  {"start": 156.0, "text": "2024年星链用户从230万"},
  {"start": 158.0, "text": "涨到了460万"},
  {"start": 159.0, "text": "全年收入约82亿美元"},
  {"start": 161.0, "text": "到今年2月"},
  {"start": 162.0, "text": "用户数量再次翻倍"},
  {"start": 163.0, "text": "已经突破了1000万"},
  {"start": 165.0, "text": "华尔街看到这个收入结构"},
  {"start": 166.0, "text": "反应只有一个"},
  {"start": 167.0, "text": "你根本不是航天公司"},
  {"start": 169.0, "text": "你是SaaS公司"},
  {"start": 170.0, "text": "你要用SaaS的逻辑定价"},
  {"start": 171.0, "text": "SpaceX的估值"},
  {"start": 172.0, "text": "又实现了第二次切换"},
  {"start": 174.0, "text": "直接又乘以30"},
  {"start": 175.0, "text": "来到了"},

  {"start": 178.0, "text": "从4亿到120亿"},
  {"start": 180.0, "text": "再到3500亿"},
  {"start": 181.0, "text": "SpaceX用了16年"},

  {"start": 182.0, "text": "而就在华尔街刚刚把它贴上"},
  {"start": 184.0, "text": "SaaS公司标签的时候"},
  {"start": 185.0, "text": "马斯克又又又带着下一个叙事进来了"},
  {"start": 188.0, "text": "就是这两年所有人都在喊的"},

  {"start": 192.0, "text": "微软为了给AI供电"},
  {"start": 193.0, "text": "重启了一座封存十几年的核电站"},
  {"start": 195.0, "text": "亚马逊也在排队抢购核能"},
  {"start": 197.0, "text": "种种迹象都在说明"},
  {"start": 198.0, "text": "地面的基础设施已经跟不上AI的胃口了"},
  {"start": 201.0, "text": "此时马斯克给出了一个疯狂的答案"},
  {"start": 203.0, "text": "把数据中心搬上天"},
  {"start": 206.0, "text": "太空里太阳能是连续的"},
  {"start": 208.0, "text": "没有昼夜"},
  {"start": 209.0, "text": "功率密度是地面的5到10倍"},
  {"start": 211.0, "text": "散热靠宇宙背景温度"},
  {"start": 212.0, "text": "接近零下270度"},
  {"start": 213.0, "text": "不需要一滴水"},
  {"start": 214.0, "text": "同时呢"},
  {"start": 215.0, "text": "马斯克的孩子里"},
  {"start": 216.0, "text": "正好就有那个耗电烧钱的xAI"},
  {"start": 219.0, "text": "这真是既能开路又有货送"},
  {"start": 221.0, "text": "2026年2月"},
  {"start": 222.0, "text": "SpaceX和xAI正式合并"},
  {"start": 224.0, "text": "估值"},
  {"start": 227.0, "text": "又创下了史上最大并购交易的纪录"},
  {"start": 230.0, "text": "但到这里你会发现"},
  {"start": 231.0, "text": "1.25万亿"},
  {"start": 232.0, "text": "怎么还没算完"},
  {"start": 233.0, "text": "我们继续看那七个孩子"},
  {"start": 235.0, "text": "天上有火箭、有卫星"},
  {"start": 237.0, "text": "地上能造车、能造机器人"},
  {"start": 238.0, "text": "一边开着AI实验室训练大模型"},
  {"start": 241.0, "text": "自己还有一个全球最大的语料库"},
  {"start": 243.0, "text": "再加上火星殖民"},
  {"start": 244.0, "text": "这种性感到让人眩晕的叙事"},
  {"start": 246.0, "text": "放眼全球"},
  {"start": 247.0, "text": "还有谁"},
  {"start": 248.0, "text": "嗯"},
  {"start": 249.0, "text": "你不算哦"},
  {"start": 250.0, "text": "所以啊"},
  {"start": 251.0, "text": "这一整套叙事"},
  {"start": 252.0, "text": "也就是剩下的那部分溢价"},
  {"start": 254.0, "text": "但问题来了"},
  {"start": 255.0, "text": "华尔街最不缺的就是叙事"},
  {"start": 256.0, "text": "那为什么SpaceX要上市的消息一出"},
  {"start": 259.0, "text": "大家都还在抢着买单呢"},

  {"start": 264.0, "text": "如果你不认识马斯克"},
  {"start": 265.0, "text": "只看这个公司的估值"},
  {"start": 266.0, "text": "62倍市销率"},
  {"start": 268.0, "text": "（保守估计）"},
  {"start": 269.0, "text": "这已经比大多数已经上市的"},
  {"start": 271.0, "text": "科技公司都要贵了"},
  {"start": 272.0, "text": "但是SpaceX的IPO还没开始"},
  {"start": 274.0, "text": "二级市场就已经抢疯了"},
  {"start": 276.0, "text": "份额频繁超额认购甚至被卖方撤回"},
  {"start": 279.0, "text": "大型资管机构甚至不惜"},
  {"start": 280.0, "text": "减仓现有的持股"},
  {"start": 282.0, "text": "来腾挪资金配额"},
  {"start": 283.0, "text": "不参与就可能跑输大盘了"},
  {"start": 285.0, "text": "到底凭什么"},

  {"start": 286.0, "text": "其实呢"},
  {"start": 287.0, "text": "这个问题的答案"},
  {"start": 288.0, "text": "得从马斯克被嘲笑的历史讲起"},
  {"start": 290.0, "text": "我带你来看看这个爱吹牛的男人"},
  {"start": 292.0, "text": "四次被嘲笑又四次打脸的故事"},

  {"start": 295.0, "text": "第一次是2002年"},
  {"start": 297.0, "text": "马斯克飞去俄罗斯"},
  {"start": 298.0, "text": "想买两枚洲际导弹改装成运载火箭"},
  {"start": 300.0, "text": "俄方开价800万一枚"},
  {"start": 302.0, "text": "他嫌贵"},
  {"start": 302.0, "text": "对方说没钱你玩什么火箭"},
  {"start": 305.0, "text": "马斯克听了之后很生气"},
  {"start": 306.0, "text": "说我要自己造"},
  {"start": 307.0, "text": "航天圈、NASA都觉得他疯了"},
  {"start": 309.0, "text": "嘲笑他是暴发户"},
  {"start": 311.0, "text": "结局你已经知道了"},
  {"start": 312.0, "text": "随着猎鹰一号入轨成功"},
  {"start": 313.0, "text": "笑声也戛然而止"},

  {"start": 317.0, "text": "第二次是马斯克说"},
  {"start": 318.0, "text": "我要让火箭的一级助推器重复使用"},
  {"start": 321.0, "text": "这个想法"},
  {"start": 322.0, "text": "连SpaceX内部的工程师都不敢相信"},
  {"start": 324.0, "text": "而到今天"},
  {"start": 325.0, "text": "猎鹰的一枚助推器"},
  {"start": 326.0, "text": "已经垂直复用了超过33次"},

  {"start": 331.0, "text": "第三次就是星链"},
  {"start": 332.0, "text": "刚刚我们说了"},
  {"start": 333.0, "text": "星链的商业模式其实不复杂"},
  {"start": 335.0, "text": "但是从提出来30多年了"},
  {"start": 336.0, "text": "就是没人跑通"},
  {"start": 338.0, "text": "因为大家有一个共识"},
  {"start": 339.0, "text": "天基互联网这件事"},
  {"start": 341.0, "text": "技术上能做"},
  {"start": 342.0, "text": "但发射成本太高"},
  {"start": 343.0, "text": "覆盖成本太高"},
  {"start": 344.0, "text": "消费者不会为它付钱"},
  {"start": 346.0, "text": "结果大家也知道了"},
  {"start": 347.0, "text": "现在星链已经是"},
  {"start": 348.0, "text": "SpaceX最主要的盈利来源"},

  {"start": 352.0, "text": "第四次也是最好玩的一次"},
  {"start": 354.0, "text": "就是做空特斯拉"},
  {"start": 355.0, "text": "而且是整个华尔街集体嘲笑"},
  {"start": 357.0, "text": "并且做空它"},
  {"start": 358.0, "text": "其中声音最响的有两个人"},
  {"start": 360.0, "text": "一个叫吉姆"},
  {"start": 361.0, "text": "他被称为“做空界的勒布朗·詹姆斯”"},
  {"start": 364.0, "text": "从2016年开始做空特斯拉"},
  {"start": 366.0, "text": "到处说这是他最喜欢的仓位"},
  {"start": 368.0, "text": "还说特斯拉是行走的资不抵债"},
  {"start": 370.0, "text": "结果呢"},
  {"start": 371.0, "text": "两年后特斯拉涨了743%"},
  {"start": 374.0, "text": "吉姆的基金从20亿蒸发到4亿"},
  {"start": 376.0, "text": "开始承认这个仓位很痛苦"},
  {"start": 378.0, "text": "非常痛苦"},

  {"start": 380.0, "text": "另一个叫大卫"},
  {"start": 381.0, "text": "绿光资本的创始人"},
  {"start": 383.0, "text": "2008年"},
  {"start": 384.0, "text": "他精准预测雷曼兄弟破产"},
  {"start": 386.0, "text": "也是华尔街最受尊敬的投资人之一"},
  {"start": 388.0, "text": "2018年"},
  {"start": 389.0, "text": "大卫开始公开贬低特斯拉"},
  {"start": 390.0, "text": "说我的特斯拉租约到期了"},
  {"start": 392.0, "text": "“很高兴不用再开这辆车了”"},
  {"start": 394.0, "text": "还说马斯克的管理能力"},
  {"start": 395.0, "text": "“很反常而且很绝望”"},
  {"start": 397.0, "text": "马斯克看到后立马在推特上回怼"},
  {"start": 399.0, "text": "“我会给你寄一盒做空短裤”"},
  {"start": 401.0, "text": "“帮你度过这段艰难时光”"},
  {"start": 403.0, "text": "因为shorts短裤和做空"},
  {"start": 405.0, "text": "在英文里是同一个词"},
  {"start": 406.0, "text": "结果他还真寄了"},
  {"start": 407.0, "text": "华尔街最受尊敬的做空大师"},
  {"start": 410.0, "text": "在社媒上亲手晒出了一条内裤"},
  {"start": 412.0, "text": "说我收到了"},
  {"start": 413.0, "text": "2020年7月"},
  {"start": 414.0, "text": "特斯拉股价再破新高的那天"},
  {"start": 416.0, "text": "马斯克在社媒放了一首金曲"},
  {"start": 418.0, "text": "《Short Shorts》"},
  {"start": 419.0, "text": "来嘲讽空头"},
  {"start": 420.0, "text": "有人算过"},
  {"start": 421.0, "text": "这些集体做空特斯拉的大空头"},
  {"start": 423.0, "text": "从2010年到2021年"},
  {"start": 425.0, "text": "账面总亏损超过645亿美元"},
  {"start": 427.0, "text": "马斯克本人对此不仅是非常得意"},
  {"start": 430.0, "text": "可以说是有点嚣张"},
  {"start": 431.0, "text": "他真的在特斯拉官网上线了"},
  {"start": 433.0, "text": "限量版的做空短裤"},
  {"start": 435.0, "text": "红色缎面，金色镶边"},
  {"start": 436.0, "text": "屁股后面绣着S3XY"},
  {"start": 440.0, "text": "每一个嘲笑过马斯克的人"},
  {"start": 441.0, "text": "最后都付出了代价"},
  {"start": 442.0, "text": "华尔街有个说法"},
  {"start": 445.0, "text": "意思是不要和有印钞权的人对赌"},
  {"start": 447.0, "text": "这两年又多了一条不成文的戒律"},
  {"start": 451.0, "text": "不是因为他每次都对"},
  {"start": 452.0, "text": "是因为你不知道他哪次是真的成了"},
  {"start": 454.0, "text": "而代价你承担不起"},

  {"start": 459.0, "text": "你看"},
  {"start": 459.0, "text": "听到这儿你会不会觉得"},
  {"start": 461.0, "text": "SpaceX做到了NASA都做不到的事情"},
  {"start": 463.0, "text": "垄断了商业航天的发射份额"},
  {"start": 465.0, "text": "星链呢"},
  {"start": 466.0, "text": "用户和份额都在稳定增长"},
  {"start": 468.0, "text": "是妥妥的现金牛"},
  {"start": 469.0, "text": "这次的IPO是不是像是"},
  {"start": 471.0, "text": "天时地利"},
  {"start": 471.0, "text": "顺理成章"},
  {"start": 472.0, "text": "水到渠成的事情"},

  {"start": 473.0, "text": "但是我们看一下"},
  {"start": 474.0, "text": "从2025年初到现在发生了什么"},
  {"start": 476.0, "text": "去年3月 xAI吞掉X"},
  {"start": 478.0, "text": "年底SpaceX吞掉了xAI"},
  {"start": 480.0, "text": "2026年刚开年"},
  {"start": 482.0, "text": "他就跟华尔街的投行排兵布阵"},
  {"start": 484.0, "text": "目标锁定6月敲钟"},
  {"start": 486.0, "text": "从并购到IPO不到一年半"},
  {"start": 488.0, "text": "这看起来会不会感觉"},
  {"start": 490.0, "text": "那个永远不提上市的SpaceX"},
  {"start": 491.0, "text": "怎么这次这么着急"},

  {"start": 495.0, "text": "其实对于这次敲钟呢"},
  {"start": 496.0, "text": "在市场上还有两种看法"},
  {"start": 498.0, "text": "非常有意思"},
  {"start": 499.0, "text": "我带你看一下"},

  {"start": 499.0, "text": "第一个就是说首富呢"},
  {"start": 501.0, "text": "其实也很缺钱"},
  {"start": 502.0, "text": "我这一个小博主说首富缺钱"},
  {"start": 505.0, "text": "你可能觉得我在搞笑"},
  {"start": 506.0, "text": "马斯克目前的公开账面资产"},
  {"start": 508.0, "text": "大概是8000亿美金"},
  {"start": 509.0, "text": "比第二名多了6000亿"},
  {"start": 511.0, "text": "但是呢"},
  {"start": 511.0, "text": "他自己也说过一句话"},
  {"start": 513.0, "text": "他的现金占净资产的比例"},
  {"start": 515.0, "text": "不到千分之一"},
  {"start": 516.0, "text": "他的七个孩子里"},
  {"start": 517.0, "text": "能去给他换钱的"},
  {"start": 518.0, "text": "主要就是SpaceX的股权"},
  {"start": 519.0, "text": "和特斯拉的股票"},

  {"start": 520.0, "text": "我们先看看特斯拉的股票"},
  {"start": 522.0, "text": "按理说没有锁定期想卖就卖"},
  {"start": 524.0, "text": "但是呢"},
  {"start": 525.0, "text": "在2025年11月"},
  {"start": 526.0, "text": "特斯拉股东大会通过了"},
  {"start": 528.0, "text": "他的天价薪酬方案"},
  {"start": 529.0, "text": "简单就是说"},
  {"start": 530.0, "text": "特斯拉市值达到8.5万亿美元"},
  {"start": 532.0, "text": "等一系列里程碑的时候"},
  {"start": 534.0, "text": "马斯克就可以获得"},
  {"start": 535.0, "text": "将近1万亿美元的股票"},
  {"start": 536.0, "text": "股东们的潜台词就是"},
  {"start": 538.0, "text": "你全力以赴把特斯拉做大"},
  {"start": 539.0, "text": "我们就用股票奖励你"},
  {"start": 541.0, "text": "如果他转头就把股票卖了"},
  {"start": 543.0, "text": "等于就在打股东的脸"},

  {"start": 544.0, "text": "2022年"},
  {"start": 545.0, "text": "他为了收购推特"},
  {"start": 546.0, "text": "就抛售过特斯拉的股票"},
  {"start": 547.0, "text": "结果被股东追着骂了半年"},
  {"start": 549.0, "text": "这次他更不敢了"},

  {"start": 551.0, "text": "另一方面"},
  {"start": 551.0, "text": "特斯拉自己的日子也不太好过"},
  {"start": 553.0, "text": "2025年净利润连续两年腰斩"},
  {"start": 556.0, "text": "去年还被比亚迪反超"},
  {"start": 557.0, "text": "抢了全球销冠的位置"},
  {"start": 559.0, "text": "欧洲销量也一直在下滑"},
  {"start": 561.0, "text": "所以他更不敢抛"},

  {"start": 563.0, "text": "剩下的一个呢"},
  {"start": 564.0, "text": "就是SpaceX的股权"},
  {"start": 565.0, "text": "它是私人公司没错"},
  {"start": 566.0, "text": "二级市场上也排着队有人想买"},
  {"start": 568.0, "text": "但从过往的融资信息来看"},
  {"start": 570.0, "text": "基本能卖的也差不多了"},
  {"start": 571.0, "text": "马斯克就剩42%的股权"},
  {"start": 573.0, "text": "再卖就卖成小股东了"},

  {"start": 575.0, "text": "那回头再看看那俩吞金兽"},
  {"start": 577.0, "text": "和那俩还在幼儿园的孩子"},
  {"start": 578.0, "text": "一加一减"},
  {"start": 579.0, "text": "马斯克这个大家庭"},
  {"start": 580.0, "text": "确实有点紧巴巴的"},

  {"start": 582.0, "text": "但是这个家庭的规划呢"},
  {"start": 583.0, "text": "又非常宏大"},
  {"start": 584.0, "text": "SpaceX的CFO"},
  {"start": 586.0, "text": "在2025年写给股东的信里就直说了"},
  {"start": 588.0, "text": "我来IPO就为了三件事"},
  {"start": 591.0, "text": "第一"},
  {"start": 591.0, "text": "星链的疯狂发射频率"},
  {"start": 593.0, "text": "第二"},
  {"start": 593.0, "text": "太空AI数据中心"},
  {"start": 595.0, "text": "第三"},
  {"start": 596.0, "text": "月球基地"},
  {"start": 597.0, "text": "这随便拿出来一件"},
  {"start": 598.0, "text": "都是需要万亿美元级别的"},
  {"start": 600.0, "text": "持续供血"},
  {"start": 601.0, "text": "这样看呢"},
  {"start": 602.0, "text": "还真得靠IPO来融资"},
  {"start": 604.0, "text": "来去为这些梦想买单"},

  {"start": 605.0, "text": "这就是第一个"},
  {"start": 606.0, "text": "首富也缺钱的说法"},

  {"start": 608.0, "text": "那第二个说法就更有意思了"},
  {"start": 610.0, "text": "是说"},
  {"start": 610.0, "text": "马斯克赶着上市"},
  {"start": 612.0, "text": "是因为他的homie"},
  {"start": 613.0, "text": "山姆·奥特曼"},
  {"start": 615.0, "text": "没错又是他"},
  {"start": 616.0, "text": "之前大家都吐槽说"},
  {"start": 617.0, "text": "怎么讲哪个AI公司都有奥特曼"},
  {"start": 619.0, "text": "2026年"},
  {"start": 620.0, "text": "不光SpaceX要上市"},
  {"start": 621.0, "text": "OpenAI也在准备IPO"},
  {"start": 623.0, "text": "大概率瞄准年底"},
  {"start": 624.0, "text": "目标是1万亿"},
  {"start": 625.0, "text": "同时冲刺的还有Anthropic"},
  {"start": 627.0, "text": "目前预计估值是3800亿"},
  {"start": 629.0, "text": "这三家加起来都3万亿了"},
  {"start": 631.0, "text": "所以呢"},
  {"start": 631.0, "text": "越早上市的"},
  {"start": 633.0, "text": "能抢到越多的市场流动性"},

  {"start": 634.0, "text": "当然呢"},
  {"start": 635.0, "text": "还有另一方面"},
  {"start": 636.0, "text": "如果你看了小李的"},
  {"start": 637.0, "text": "硅谷权力争霸系列视频"},
  {"start": 639.0, "text": "肯定懂"},
  {"start": 639.0, "text": "哪怕从心理上"},
  {"start": 640.0, "text": "马斯克也一定要抢这个先"},

  {"start": 642.0, "text": "好说到这里"},
  {"start": 643.0, "text": "关于马斯克这1.5万亿怎么来的"},
  {"start": 645.0, "text": "为什么有人买单"},
  {"start": 646.0, "text": "以及为什么这么着急上市"},
  {"start": 648.0, "text": "都讲完了"},

  {"start": 652.0, "text": "接下来"},
  {"start": 652.0, "text": "我想和你聊一个"},
  {"start": 653.0, "text": "更深层的问题"},

  {"start": 654.0, "text": "如果这个IPO成了"},
  {"start": 656.0, "text": "我们这些吃瓜群众"},
  {"start": 657.0, "text": "正在见证的"},
  {"start": 658.0, "text": "是人类历史上第一次"},
  {"start": 660.0, "text": "一个人"},
  {"start": 660.0, "text": "同时掌握这么多"},
  {"start": 662.0, "text": "关键基础设施"},
  {"start": 663.0, "text": "而没有任何力量能制衡他"},

  {"start": 668.0, "text": "17世纪有个英国哲学家"},
  {"start": 669.0, "text": "叫霍布斯"},
  {"start": 670.0, "text": "写了一本书叫《利维坦》"},
  {"start": 672.0, "text": "他说"},
  {"start": 672.0, "text": "人类为了摆脱混乱"},
  {"start": 674.0, "text": "会自愿把权力交给一个"},
  {"start": 675.0, "text": "无比强大的主权者"},
  {"start": 677.0, "text": "这个主权者"},
  {"start": 678.0, "text": "强大到可以保护所有人"},
  {"start": 679.0, "text": "但也强大到"},
  {"start": 680.0, "text": "没有任何人能约束他"},
  {"start": 682.0, "text": "霍布斯把这种超级权力体"},
  {"start": 684.0, "text": "叫作“利维坦”"},

  {"start": 685.0, "text": "这来源于《圣经》里"},
  {"start": 686.0, "text": "一种不可战胜的海怪"},

  {"start": 687.0, "text": "马斯克似乎也正在"},
  {"start": 689.0, "text": "变成一头商业利维坦"},

  {"start": 691.0, "text": "在商业历史上"},
  {"start": 692.0, "text": "也出现过垄断巨头"},
  {"start": 693.0, "text": "洛克菲勒控制石油"},
  {"start": 695.0, "text": "卡内基控制钢铁"},
  {"start": 696.0, "text": "贝尔控制电话"},
  {"start": 697.0, "text": "但每一个都只垄断了一个领域"},
  {"start": 699.0, "text": "而且最终都被政府拆分了"},

  {"start": 701.0, "text": "马斯克同时握住了五个"},
  {"start": 703.0, "text": "而且它们不是孤立的"},
  {"start": 704.0, "text": "反而构成了一个闭环"},
  {"start": 706.0, "text": "星链提供通信管道"},
  {"start": 708.0, "text": "X提供数据和用户入口"},
  {"start": 710.0, "text": "几百万辆特斯拉"},
  {"start": 711.0, "text": "在真实世界训练"},
  {"start": 712.0, "text": "Grok处理信息"},
  {"start": 713.0, "text": "SpaceX提供物理运输通道"},
  {"start": 715.0, "text": "控制了其中任何一个环节"},
  {"start": 717.0, "text": "就能影响其他所有环节"},
  {"start": 719.0, "text": "控制了全部"},
  {"start": 720.0, "text": "就是一个自给自足的生态系统"},

  {"start": 722.0, "text": "俄乌战争期间"},
  {"start": 723.0, "text": "乌克兰军方依赖星链维持战场通信"},
  {"start": 726.0, "text": "有一次"},
  {"start": 726.0, "text": "乌克兰请求马斯克将星链覆盖范围"},
  {"start": 729.0, "text": "延伸至克里米亚近海"},
  {"start": 730.0, "text": "用于引导无人艇攻击俄罗斯黑海舰队"},
  {"start": 733.0, "text": "马斯克拒绝了"},
  {"start": 734.0, "text": "因为他担心此举会引发核战争升级"},
  {"start": 736.0, "text": "结果"},
  {"start": 737.0, "text": "那批载着炸药接近俄舰的无人艇"},
  {"start": 739.0, "text": "失去信号"},
  {"start": 740.0, "text": "搁浅上岸"},
  {"start": 741.0, "text": "一个商人凭个人判断"},
  {"start": 743.0, "text": "直接影响了一场战争的走向"},
  {"start": 745.0, "text": "你可以说他的判断是对的"},
  {"start": 747.0, "text": "但问题不在于对错"},
  {"start": 748.0, "text": "而在于这个决定"},
  {"start": 750.0, "text": "本来应该由谁来做"},
  {"start": 751.0, "text": "一个国家的总统"},
  {"start": 753.0, "text": "一个联合国安理会的决议"},
  {"start": 754.0, "text": "还是一个坐在德州豪宅里刷手机的亿万富翁"},
  {"start": 757.0, "text": "而现在"},
  {"start": 758.0, "text": "传统的制衡手段对他几乎全部失效"},
  {"start": 761.0, "text": "你说有反垄断"},
  {"start": 762.0, "text": "他的业务横跨太空、通信"},
  {"start": 764.0, "text": "AI、社交媒体、汽车"},
  {"start": 766.0, "text": "没有任何一个监管机构的管辖范围"},
  {"start": 768.0, "text": "能够完整覆盖他"},
  {"start": 769.0, "text": "你说靠股东制衡"},
  {"start": 771.0, "text": "他的双重股权结构"},
  {"start": 772.0, "text": "一票否决权"},
  {"start": 773.0, "text": "都意味着绝对的话语权"},
  {"start": 775.0, "text": "那最后的政府约束呢"},
  {"start": 776.0, "text": "SpaceX是NASA和五角大楼里"},
  {"start": 778.0, "text": "最重要的发射承包商"},
  {"start": 780.0, "text": "它2025年全年完成了165次轨道发射"},
  {"start": 783.0, "text": "占全美轨道发射的比例"},
  {"start": 784.0, "text": "已经达到了恐怖的85%"},
  {"start": 786.0, "text": "政府对它的依赖程度"},
  {"start": 788.0, "text": "已经到了不敢得罪的地步"},
  {"start": 789.0, "text": "而且这已经不是推演"},
  {"start": 791.0, "text": "是正发生在当下的事"},
  {"start": 793.0, "text": "2025年6月"},
  {"start": 794.0, "text": "马斯克因为公开批评特朗普的支出法案"},
  {"start": 796.0, "text": "和总统在社交媒体上彻底撕破了脸"},
  {"start": 799.0, "text": "特朗普威胁要取消SpaceX所有的政府合同"},
  {"start": 802.0, "text": "马斯克的回应是什么"},
  {"start": 803.0, "text": "他在X上宣布"},
  {"start": 805.0, "text": "“SpaceX将立即开始退役龙飞船”"},
  {"start": 807.0, "text": "而这是目前美国唯一能把宇航员"},
  {"start": 810.0, "text": "送上国际空间站的飞船"},
  {"start": 812.0, "text": "这句话的潜台词就是"},
  {"start": 813.0, "text": "你敢动我的合同"},
  {"start": 814.0, "text": "我就让你的宇航员没有回家的船"},
  {"start": 817.0, "text": "美国的载人航天"},
  {"start": 818.0, "text": "只能去求俄罗斯和中国"},
  {"start": 820.0, "text": "虽然几小时后他就说"},
  {"start": 821.0, "text": "“好吧，不退役了”"},
  {"start": 822.0, "text": "但这几个小时"},
  {"start": 823.0, "text": "足以让全世界看清一件事"},
  {"start": 825.0, "text": "一个商人"},
  {"start": 826.0, "text": "可以拿一个国家的太空能力当筹码"},
  {"start": 829.0, "text": "和总统讨价还价"},
  {"start": 830.0, "text": "而总统最终也没能真的取消那些合同"},
  {"start": 833.0, "text": "因为官员们评估后发现"},
  {"start": 834.0, "text": "这些合同对美国国家安全太关键了"},
  {"start": 837.0, "text": "根本取消不了"},
  {"start": 838.0, "text": "而另一个更深层的问题是"},
  {"start": 840.0, "text": "他同时还拥有一个社交媒体平台"},
  {"start": 842.0, "text": "和一个AI工具"},
  {"start": 843.0, "text": "一个控制了你看到什么信息"},
  {"start": 845.0, "text": "一个控制你怎么理解这些信息"},
  {"start": 847.0, "text": "这次IPO如果成功了"},
  {"start": 849.0, "text": "意味着资本市场正式给这个模式盖了章"},
  {"start": 852.0, "text": "华尔街认同了一个人"},
  {"start": 853.0, "text": "可以同时掌握通信"},
  {"start": 854.0, "text": "AI、太空通道和舆论场"},
  {"start": 856.0, "text": "而且不需要向任何人交出控制权"},
  {"start": 858.0, "text": "这已经不是一个商业先例"},
  {"start": 860.0, "text": "更是一个权力的先例"},
  {"start": 862.0, "text": "权力的尽头是什么"},
  {"start": 863.0, "text": "是跳出原来的牌桌"},
  {"start": 864.0, "text": "自己去写新的法律"},
  {"start": 866.0, "text": "不知道大家有没有看过"},
  {"start": 867.0, "text": "星链的用户服务条款"},
  {"start": 869.0, "text": "在那份冗长的"},
  {"start": 870.0, "text": "几乎没人会仔细看的法律文件里"},
  {"start": 872.0, "text": "藏着一条让人倒吸一口凉气的第九条款"},
  {"start": 875.0, "text": "里面明文写着"},
  {"start": 876.0, "text": "“对于在火星上提供的服务”"},
  {"start": 878.0, "text": "“各方承认火星是一个自由星球”"},
  {"start": 881.0, "text": "“没有任何地球政府对火星活动”"},
  {"start": 883.0, "text": "“拥有管辖权或主权”"},
  {"start": 885.0, "text": "“争端将通过善意建立的自治原则来解决”"},
  {"start": 888.0, "text": "在地球上"},
  {"start": 889.0, "text": "他是首富"},
  {"start": 890.0, "text": "是受SEC监管的CEO"},
  {"start": 892.0, "text": "但是在他铺设的太空网络里"},
  {"start": 894.0, "text": "在他未来的火星基地上"},
  {"start": 896.0, "text": "他就是唯一的规则制定者"},
  {"start": 898.0, "text": "白天你开着特斯拉在路上跑"},
  {"start": 900.0, "text": "车上的摄像头在帮他的自动驾驶"},
  {"start": 902.0, "text": "收集现实世界的空间数据"},
  {"start": 904.0, "text": "晚上你躺在床上刷着X"},
  {"start": 906.0, "text": "你的每次点赞、转发"},
  {"start": 907.0, "text": "愤怒和狂欢都在喂养他的Grok大模型"},
  {"start": 910.0, "text": "无论你在地球的哪个角落"},
  {"start": 912.0, "text": "哪怕是深山老林"},
  {"start": 913.0, "text": "只要你连上网"},
  {"start": 914.0, "text": "用的就是他头顶的星链"},
  {"start": 916.0, "text": "这也解释了"},
  {"start": 917.0, "text": "为什么他一定要在这个时候"},
  {"start": 919.0, "text": "把xAI装进SpaceX里"},
  {"start": 921.0, "text": "急匆匆地推向神坛"},
  {"start": 922.0, "text": "因为这头利维坦"},
  {"start": 924.0, "text": "正在完成"},
  {"start": 924.0, "text": "它的最后一次进化"},
  {"start": 925.0, "text": "而就在我准备这期视频的时候"},
  {"start": 927.0, "text": "3月22号"},
  {"start": 928.0, "text": "马斯克又宣布了一个更疯狂的消息"},
  {"start": 931.0, "text": "Terafab芯片工厂"},
  {"start": 932.0, "text": "由特斯拉、SpaceX、xAI三家联合打造"},
  {"start": 936.0, "text": "目标是每年生产"},
  {"start": 937.0, "text": "1太瓦AI算力芯片"},
  {"start": 938.0, "text": "部署至太空"},
  {"start": 941.0, "text": "此时我们再回头看看"},
  {"start": 943.0, "text": "马斯克的七个孩子"},
  {"start": 944.0, "text": "特斯拉停产了Model S和X两款车型"},
  {"start": 947.0, "text": "腾出生产线量产Optimus机器人"},
  {"start": 949.0, "text": "这是身体"},
  {"start": 950.0, "text": "xAI的算力即将通过SpaceX火箭上天"},
  {"start": 953.0, "text": "这是大脑"},
  {"start": 954.0, "text": "这是大脑"},
  {"start": 955.0, "text": "X每秒吞食几亿人的语言数据"},
  {"start": 957.0, "text": "喂养Grok"},
  {"start": 958.0, "text": "这是眼睛和嘴巴"},
  {"start": 960.0, "text": "Neuralink已经让13个人把芯片插进了大脑"},
  {"start": 963.0, "text": "这是接口"},
  {"start": 965.0, "text": "而SpaceX的火箭是带他们去火星的腿"},
  {"start": 968.0, "text": "马斯克好像不只是在做生意"},
  {"start": 970.0, "text": "而是在攒零件"},
  {"start": 971.0, "text": "你有没有想象过一个画面"},
  {"start": 973.0, "text": "一个机器人站在火星的红色沙地上"},
  {"start": 975.0, "text": "头顶是星链织成的信号网"},
  {"start": 978.0, "text": "胸腔里跑着Grok的大模型"},
  {"start": 979.0, "text": "脑干里插着Neuralink的芯片"},
  {"start": 981.0, "text": "他睁开眼睛"},
  {"start": 983.0, "text": "看到的第一缕光"},
  {"start": 984.0, "text": "来自一颗距离地球2亿公里的太阳"},
  {"start": 986.0, "text": "这个画面十年前是科幻"},
  {"start": 989.0, "text": "但今天"},
  {"start": 989.0, "text": "造出它所需要的每一块拼图"},
  {"start": 991.0, "text": "都已经握在同一个人手里了"},
  {"start": 994.0, "text": "所以问题变成了"},
  {"start": 995.0, "text": "这个人最终想要的还会只是一家公司吗"},
  {"start": 998.0, "text": "硅基生命的诞生"},
  {"start": 1000.0, "text": "是否会比我们所有人预期的都还要快"},
  {"start": 1002.0, "text": "而碳基生命又究竟是迎来了落幕"},
  {"start": 1004.0, "text": "还是正在成为一场新文明的造物主"},
  {"start": 1007.0, "text": "屏幕前的你想必心里已经有了答案"},
  {"start": 1009.0, "text": "欢迎留言在评论区"},
  {"start": 1011.0, "text": "到时回来挖坟"},
  {"start": 1012.0, "text": "大家好我是小李"},
  {"start": 1013.0, "text": "如果今天的视频让你觉得"},
  {"start": 1014.0, "text": "有所收获"},
  {"start": 1014.0, "text": "有所思考"},
  {"start": 1015.0, "text": "请给小李点赞、评论、收藏"},
  {"start": 1016.0, "text": "这对我真的很重要"}
]